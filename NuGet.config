<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Only nuget.org: <clear /> drops every source inherited from the user or machine config. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <!-- Every package must come from a mapped source. With one source this only documents the rule; a private feed
       added later gets its own exclusive prefix (for example LearnHub.*), which blocks dependency confusion. -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
