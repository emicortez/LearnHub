<Project Sdk="Microsoft.NET.Sdk">

  <!-- Runs against a real PostgreSQL container: Docker must be running. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\..\..\src\Services\Catalog\LearnHub.Catalog.Infrastructure\Persistence\Schema\*.sql"
          LinkBase="Schema"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
